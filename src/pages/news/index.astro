---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

const newsItems = [
  {
    slug: '2026-strategic-plan',
    date: '2026-06-01',
    category: '集团动态',
    title: '宏邦集团2026年度战略规划发布',
    summary: '集团正式发布2026年度战略规划，聚焦AI大模型应用、芯片设计国产化替代及供应链数字化转型三大方向，目标三年内营收突破5亿元。',
  },
  {
    slug: 'baijie-state-owned-cooperation',
    date: '2026-05-15',
    category: '科技前沿',
    title: '武汉百杰科技与多家国企达成集成电路技术合作',
    summary: '集团旗下武汉百杰科技与武汉多家国有科技企业签署集成电路设计与储能技术合作协议，共同推进国产芯片技术攻关与产业化落地。',
  },
  {
    slug: 'jujiaji-chip-supply-chain',
    date: '2026-04-20',
    category: '贸易资讯',
    title: '杭州巨嘉吉贸易拓展芯片供应链上下游合作',
    summary: '杭州巨嘉吉贸易与多家高新企业签署电子元器件及芯片供应合作协议，持续深耕芯片贸易与供应链服务领域。',
  },
  {
    slug: 'hongan-xingchen-capital-increase',
    date: '2026-03-10',
    category: '投资布局',
    title: '宏邦集团完成对宏安兴宸新材料增资',
    summary: '集团完成对参投企业宏安兴宸新材料的增资扩股，持股比例提升至15%，进一步深化电子专用材料领域布局。',
  },
  {
    slug: 'aoshfan-ai-chip-platform',
    date: '2026-02-28',
    category: '科技前沿',
    title: '苏州奥斯帆科技发布自研AI芯片验证平台',
    summary: '苏州奥斯帆科技正式发布自主研发的AI芯片验证平台V1.0，为国内芯片设计企业提供高效低成本的验证解决方案。',
  },
  {
    slug: '2025-annual-summary',
    date: '2026-01-15',
    category: '集团动态',
    title: '宏邦集团2025年度总结暨2026新春年会圆满举行',
    summary: '集团在武汉总部举行2025年度总结大会，全年营收突破1.48亿元，同比增长450%，各板块业务均实现跨越式发展。',
  },
];

const categories = ['全部', '集团动态', '科技前沿', '贸易资讯', '投资布局'];
---

<Layout title="新闻动态 - 宏邦集团">
  <Navbar />

  <!-- Hero banner -->
  <section class="relative pt-32 pb-20 parchment-bg-alt hero-pattern">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-seal-500 text-sm tracking-widest uppercase mb-4 block">LATEST NEWS</span>
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-ink-800">新闻动态</h1>
      <p class="text-ink-400 text-lg">了解宏邦集团最新动态</p>
    </div>
  </section>

  <!-- Filter tabs -->
  <section class="bg-parchment-50 border-b border-parchment-200/50 sticky top-16 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 py-4 overflow-x-auto" id="news-tabs">
        {categories.map((cat, i) => (
          <button
            class={`news-tab px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors duration-200 ${i === 0 ? 'bg-ink-700 text-parchment-50' : 'bg-parchment-100 text-ink-400 hover:bg-parchment-200'}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- News grid -->
  <section class="py-16 parchment-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8" id="news-grid">
        {newsItems.map((item) => (
          <a href={`/news/${item.slug}`} class="news-card group block rounded-xl overflow-hidden bg-parchment-50 border border-parchment-200/50 shadow-sm hover:shadow-md hover:border-parchment-400 transition-all duration-300 hover:-translate-y-1" data-category={item.category}>
            <!-- Content -->
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-ink-300 text-xs">{item.date}</span>
                <span class="px-2 py-0.5 rounded-full text-xs bg-seal-50 text-seal-600 border border-seal-100">{item.category}</span>
              </div>
              <h3 class="text-lg font-bold mb-3 text-ink-800 group-hover:text-seal-500 transition-colors leading-snug">{item.title}</h3>
              <p class="text-ink-400 text-sm leading-relaxed mb-4">{item.summary}</p>
              <span class="text-seal-500 text-sm font-medium inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                阅读更多
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Pagination placeholder -->
      <div class="flex items-center justify-center mt-16 gap-2">
        <button class="w-10 h-10 rounded-lg bg-ink-700 text-parchment-50 text-sm font-medium">1</button>
        <button class="w-10 h-10 rounded-lg bg-parchment-100 text-ink-400 text-sm font-medium hover:bg-parchment-200 transition-colors">2</button>
        <button class="w-10 h-10 rounded-lg bg-parchment-100 text-ink-400 text-sm font-medium hover:bg-parchment-200 transition-colors">3</button>
        <span class="text-ink-400 px-2">...</span>
        <button class="w-10 h-10 rounded-lg bg-parchment-100 text-ink-400 text-sm font-medium hover:bg-parchment-200 transition-colors">下一页</button>
      </div>
    </div>
  </section>
</Layout>

<script>
  const tabs = document.querySelectorAll('.news-tab');
  const cards = document.querySelectorAll('.news-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      // Update active tab
      tabs.forEach((t) => {
        t.classList.remove('bg-ink-700', 'text-parchment-50');
        t.classList.add('bg-parchment-100', 'text-ink-400');
      });
      tab.classList.remove('bg-parchment-100', 'text-ink-400');
      tab.classList.add('bg-ink-700', 'text-parchment-50');

      const category = tab.getAttribute('data-category');

      // Filter cards
      cards.forEach((card) => {
        if (category === '全部' || card.getAttribute('data-category') === category) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

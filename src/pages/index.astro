---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero';
import Overview from '../components/Overview.astro';
import Business from '../components/Business.astro';
import Timeline from '../components/Timeline.astro';
import Subsidiaries from '../components/Subsidiaries.astro';
import Organization from '../components/Organization.astro';
import Finance from '../components/Finance';
import Contact from '../components/Contact.astro';
---

<Layout>
  <Navbar />
  <Hero client:load />
  <Overview />
  <Business />
  <Timeline />
  <Subsidiaries />
  <Organization />
  <Finance client:visible />
  <Contact />
</Layout>

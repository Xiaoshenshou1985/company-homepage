---
const goals = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    title: '科技引领',
    desc: '持续深耕AI、芯片设计、区块链等前沿技术，打造具有核心竞争力的科技产品矩阵',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: '产业协同',
    desc: '深化科技、贸易、投资三大板块协同效应，构建产业生态闭环',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    title: '价值创造',
    desc: '目标三年内营收突破5亿元，为股东和社会创造持续回报',
  },
];
---

<section id="vision" class="py-24 md:py-32 bg-ink-800 relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-parchment-200/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-parchment-200/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Section header -->
    <div class="text-center mb-16 scroll-reveal">
      <span class="text-parchment-400/60 text-sm tracking-widest uppercase mb-4 block">OUR VISION</span>
      <h2 class="text-3xl md:text-5xl font-bold mb-6 text-parchment-50">发展愿景</h2>
      <div class="w-20 h-1 bg-parchment-400/30 mx-auto rounded-full"></div>
    </div>

    <!-- Vision statement -->
    <div class="text-center mb-16 scroll-reveal">
      <p class="text-xl md:text-2xl text-parchment-100/90 leading-relaxed max-w-3xl mx-auto font-medium">
        以科技为引擎，以产业为根基，打造横跨硬科技+供应链+资本运作的综合性产业集团
      </p>
    </div>

    <!-- Goal cards -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      {goals.map((goal, i) => (
        <div class="scroll-reveal p-8 rounded-2xl bg-parchment-50/5 backdrop-blur-sm border border-parchment-200/10 text-center hover:bg-parchment-50/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-parchment-50/10 flex items-center justify-center text-parchment-200">
            <Fragment set:html={goal.icon} />
          </div>
          <h3 class="text-xl font-bold mb-3 text-parchment-50">{goal.title}</h3>
          <p class="text-parchment-200/70 text-sm leading-relaxed">{goal.desc}</p>
        </div>
      ))}
    </div>

    <!-- 2026 target highlight -->
    <div class="scroll-reveal text-center">
      <div class="inline-block px-8 py-4 rounded-2xl bg-parchment-50/5 border border-parchment-200/10">
        <div class="text-parchment-400/60 text-xs tracking-widest mb-2">2026 目标</div>
        <div class="text-3xl md:text-4xl font-bold text-parchment-50">三年营收突破 <span class="text-seal-300">5亿元</span></div>
      </div>
    </div>
  </div>
</section>

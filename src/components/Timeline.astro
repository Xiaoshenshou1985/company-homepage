---
const milestones = [
  {
    year: '2021',
    title: '启航之年',
    desc: '苏州奥斯帆科技成立，集团科技板块的先行者，奠定技术基础',
    tag: '苏州奥斯帆科技成立',
  },
  {
    year: '2022',
    title: '拓展布局',
    desc: '苏州金许知科技成立，进一步深耕软件与电子元器件领域',
    tag: '苏州金许知科技成立',
  },
  {
    year: '2023.10',
    title: '集团成立',
    desc: '宏邦集团正式成立，注册资本5000万元，整合资源开启集团化运营新篇章',
    tag: '宏邦集团正式成立',
    highlight: true,
  },
  {
    year: '2024.02',
    title: '贸易突破',
    desc: '杭州巨嘉吉贸易成立，进军大宗商品贸易与供应链管理领域',
    tag: '杭州巨嘉吉贸易成立',
  },
  {
    year: '2024.03',
    title: '科技深耕',
    desc: '武汉百杰科技成立，聚焦区块链、芯片设计与储能技术',
    tag: '武汉百杰科技成立',
  },
  {
    year: '2025',
    title: '跨越发展',
    desc: '营收突破1.48亿元，同比增长450%，净利润254万元，同比增长474%，总资产达6572万元',
    tag: '营收突破1.48亿元',
    highlight: true,
  },
];
---

<section id="timeline" class="py-24 md:py-32 bg-navy-950 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 scroll-reveal">
      <span class="text-gold-400 text-sm tracking-widest uppercase mb-4 block">DEVELOPMENT</span>
      <h2 class="text-3xl md:text-5xl font-bold mb-6">发展历程</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-gold-400 to-gold-600 mx-auto rounded-full"></div>
    </div>

    <!-- Timeline -->
    <div class="relative max-w-4xl mx-auto">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-gold-400/50 via-white/10 to-transparent md:-translate-x-px"></div>

      {milestones.map((m, i) => (
        <div class={`scroll-reveal relative flex items-start mb-12 last:mb-0 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
          <!-- Dot on timeline -->
          <div class={`absolute left-4 md:left-1/2 w-3 h-3 rounded-full -translate-x-1.5 md:-translate-x-1.5 mt-2 z-10 ${m.highlight ? 'bg-gold-400 shadow-lg shadow-gold-400/30' : 'bg-white/30 border-2 border-navy-950'}`}></div>

          <!-- Content -->
          <div class={`ml-12 md:ml-0 md:w-[calc(50%-2rem)] ${i % 2 === 0 ? 'md:pr-8 md:text-right' : 'md:pl-8 md:text-left'}`}>
            <div class={`p-6 rounded-xl border transition-colors duration-300 ${m.highlight ? 'bg-gold-500/5 border-gold-500/20' : 'bg-white/[0.02] border-white/[0.06] hover:border-white/10'}`}>
              <div class={`text-gold-400 font-bold text-lg mb-1 ${m.highlight ? 'text-gold-300' : ''}`}>{m.year}</div>
              <h3 class="text-xl font-bold mb-2 text-white">{m.title}</h3>
              <p class="text-white/50 text-sm leading-relaxed mb-3">{m.desc}</p>
              <span class={`inline-block px-3 py-1 rounded-full text-xs ${m.highlight ? 'bg-gold-500/10 text-gold-400 border border-gold-500/20' : 'bg-white/[0.04] text-white/40 border border-white/[0.06]'}`}>
                {m.tag}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

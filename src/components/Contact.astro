---
const contactInfo = [
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>`,
    label: '官方网站',
    value: 'hongbang.org.cn',
    href: 'https://hongbang.org.cn',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    label: '电子邮箱',
    value: 'service@hongbang.org.cn',
    href: 'mailto:service@hongbang.org.cn',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>`,
    label: '联系电话',
    value: '156 0863 0899',
    href: 'tel:15608630899',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    label: '公司地址',
    value: '武汉市江汉区精武路1号越秀国际金融汇T2栋',
    href: '#',
  },
];
---

<section id="contact" class="py-24 md:py-32 bg-ink-800 text-parchment-50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 scroll-reveal">
      <span class="text-seal-300 text-sm tracking-widest uppercase mb-4 block">CONTACT US</span>
      <h2 class="text-3xl md:text-5xl font-bold mb-6 text-parchment-50">联系我们</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-seal-400 to-seal-600 mx-auto rounded-full"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {contactInfo.map((info, i) => (
        <a
          href={info.href}
          class="scroll-reveal group flex items-start gap-4 p-6 rounded-xl bg-parchment-50/5 border border-parchment-200/10 hover:border-seal-400/30 transition-all duration-300 hover:-translate-y-0.5"
        >
          <div class="w-12 h-12 rounded-xl bg-parchment-50/5 flex items-center justify-center text-seal-300 flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
            <Fragment set:html={info.icon} />
          </div>
          <div>
            <div class="text-parchment-400/40 text-xs mb-1">{info.label}</div>
            <div class="text-parchment-100/80 text-sm group-hover:text-seal-300 transition-colors">{info.value}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- Map placeholder -->
    <div class="scroll-reveal mt-12 max-w-4xl mx-auto">
      <div class="rounded-xl overflow-hidden border border-parchment-200/10 bg-parchment-50/5 h-48 flex items-center justify-center">
        <div class="text-center">
          <svg class="w-8 h-8 text-parchment-200/20 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p class="text-parchment-200/20 text-sm">武汉市江汉区精武路1号越秀国际金融汇T2栋</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-12 bg-ink-800 border-t border-parchment-200/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Logo & name -->
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-seal-400 to-seal-600 flex items-center justify-center font-bold text-parchment-50 text-xs">
          宏
        </div>
        <div>
          <div class="text-parchment-100/80 font-bold text-sm">宏邦集团</div>
          <div class="text-parchment-200/30 text-[10px] tracking-widest">HONGBANG GROUP</div>
        </div>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6 text-parchment-200/40 text-xs">
        <a href="/" class="hover:text-seal-300 transition-colors">首页</a>
        <a href="/about" class="hover:text-seal-300 transition-colors">关于我们</a>
        <a href="/news" class="hover:text-seal-300 transition-colors">新闻动态</a>
        <a href="/#business" class="hover:text-seal-300 transition-colors">业务板块</a>
        <a href="/#contact" class="hover:text-seal-300 transition-colors">联系我们</a>
      </div>

      <!-- Copyright -->
      <div class="text-parchment-200/20 text-xs">
        © 2023-2026 湖北宏邦商务服务有限公司 版权所有
      </div>
    </div>
  </div>
</footer>

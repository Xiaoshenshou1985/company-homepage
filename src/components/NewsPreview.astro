---
const newsItems = [
  {
    date: '2026-06-01',
    title: '宏邦集团2026年度战略规划发布',
    summary: '集团正式发布2026年度战略规划，聚焦AI大模型应用、芯片设计国产化替代及供应链数字化转型三大方向。',
  },
  {
    date: '2026-05-15',
    title: '武汉百杰科技获批省级重点实验室',
    summary: '集团旗下武汉百杰科技获批建设湖北省区块链与数字资产重点实验室，标志着集团科研能力获得官方认可。',
  },
  {
    date: '2026-04-20',
    title: '杭州巨嘉吉贸易与多家央企签署战略合作',
    summary: '杭州巨嘉吉贸易与中国五矿、中化集团等央企签署大宗商品供应战略合作协议，年度合同金额超8000万元。',
  },
];
---

<section id="news" class="py-24 md:py-32 parchment-bg-alt relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 scroll-reveal">
      <span class="text-seal-500 text-sm tracking-widest uppercase mb-4 block">LATEST NEWS</span>
      <h2 class="text-3xl md:text-5xl font-bold mb-6 text-ink-800">新闻动态</h2>
      <div class="w-20 h-1 bg-gradient-to-r from-ink-600 to-ink-400 mx-auto rounded-full"></div>
    </div>

    <!-- News cards -->
    <div class="grid md:grid-cols-3 gap-8">
      {newsItems.map((item, i) => (
        <a href="/news" class="scroll-reveal group block p-6 rounded-2xl bg-parchment-50 border border-parchment-200/50 shadow-sm hover:shadow-md hover:border-parchment-400 transition-all duration-300 hover:-translate-y-1">
          <div class="text-seal-500 text-sm font-medium mb-3">{item.date}</div>
          <h3 class="text-lg font-bold mb-3 text-ink-800 group-hover:text-seal-500 transition-colors leading-snug">{item.title}</h3>
          <p class="text-ink-400 text-sm leading-relaxed mb-4">{item.summary}</p>
          <span class="text-seal-500 text-sm font-medium inline-flex items-center gap-1 group-hover:gap-2 transition-all">
            阅读更多
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <!-- View all button -->
    <div class="text-center mt-12 scroll-reveal">
      <a href="/news" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-ink-600 text-ink-600 font-medium text-sm hover:bg-ink-700 hover:text-parchment-50 transition-colors duration-300">
        查看全部新闻
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
